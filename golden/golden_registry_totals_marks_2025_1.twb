              <calculation class='tableau' formula='1 - SUM([Sales]) / MAX({FIXED : SUM([Sales])})' />
            </column>
            <column caption='Regions · Sales · Bar' datatype='real' name='[Calculation_8116426778507576864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([Region]) &lt;= 1 THEN SUM([Sales]) ELSE 0 END' />
            </column>
            <column caption='Regions · Of total · Share' datatype='real' default-format='p0%' name='[Calculation_9610336003454132415]' role='measure' type='quantitative'>
