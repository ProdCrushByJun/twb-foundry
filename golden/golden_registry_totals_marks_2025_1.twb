            <column caption='Regions · Sales · Flag' datatype='string' name='[Calculation_4514938454310298528]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF NOT (COUNTD([Region]) &lt;= 1) THEN &quot;Total&quot; ELSEIF SUM([Sales]) &gt; 35000 THEN &quot;Flagged&quot; ELSE &quot;Row&quot; END' />
            </column>
            <column caption='Regions · # · Cell' datatype='integer' name='[Calculation_6001981822932687674]' role='measure' type='quantitative'>
