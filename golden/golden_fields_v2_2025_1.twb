      <column caption='Order Size' datatype='string' name='[Calculation_1014154018034077524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales] &gt;= 300 THEN &quot;Large&quot; ELSEIF [Sales] &gt;= 150 THEN &quot;Medium&quot; ELSE &quot;Small&quot; END' />
