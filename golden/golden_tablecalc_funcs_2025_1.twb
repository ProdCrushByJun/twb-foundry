      <column caption='Sales Rank' datatype='integer' name='[Calculation_1551733437190854903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative Avg' datatype='real' name='[Calculation_1881036399530708934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales]), FIRST(), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
