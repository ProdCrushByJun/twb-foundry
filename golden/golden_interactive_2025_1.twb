          <datasource-dependencies datasource='federated.lyl8wthdb6068eodoaqvdj3tew32'>
            <column caption='Metric value' datatype='real' name='[Calculation_7325679637406209574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Sales&quot; THEN SUM([Sales]) WHEN &quot;Profit&quot; THEN SUM([Profit]) WHEN &quot;Quantity&quot; THEN SUM([Quantity]) END' />
            </column>
            <column caption='Period filter' datatype='boolean' name='[Calculation_9892914390142087505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &quot;L3M&quot; THEN DATEDIFF(&apos;month&apos;, [Order Date], {FIXED : MAX([Order Date])}) &lt; 3 WHEN &quot;L6M&quot; THEN DATEDIFF(&apos;month&apos;, [Order Date], {FIXED : MAX([Order Date])}) &lt; 6 WHEN &quot;L9M&quot; THEN DATEDIFF(&apos;month&apos;, [Order Date], {FIXED : MAX([Order Date])}) &lt; 9 WHEN &quot;All&quot; THEN TRUE END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_9892914390142087505]' derivation='None' name='[none:Calculation_9892914390142087505:nk]' pivot='key' type='nominal' />
