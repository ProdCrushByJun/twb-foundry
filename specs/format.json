{
  "$schema": "../tbuilder/spec.schema.json",
  "version": 1,
  "block_headers": false,
  "declutter": false,
  "datasource": {"type": "csv", "path": "../data/sample/sales.csv"},
  "sheets": [
    {"name": "KPI", "type": "kpi", "style": "tiles", "measures": [
      {"field": "Sales", "label": "Total Sales"}, {"field": "Profit"}, {"field": "Quantity", "label": "Units"}]},
    {"name": "Bar", "type": "bar", "title": "Sales by Region (sorted)", "dimension": "Region", "measure": {"field": "Sales"}, "sort": "desc"},
    {"name": "Line", "type": "line", "title": "Monthly Sales Trend", "date": {"field": "Order Date", "level": "month"}, "measure": {"field": "Sales"}},
    {"name": "Table", "type": "table", "rows": "Region", "cols": "Category", "measure": {"field": "Sales"}}
  ],
  "filters": [{"field": "Region", "show_on": "Table"}],
  "dashboard": {"theme": "flat", "name": "Overview", "width": 1200, "height": 800, "row_heights": [1, 3],
                "grid": [["KPI"], [{"sheet": "Bar", "width": 1}, {"sheet": "Line", "width": 2}, "Table"]]}
}
