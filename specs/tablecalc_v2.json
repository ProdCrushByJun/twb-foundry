{
  "$schema": "../tbuilder/spec.schema.json",
  "version": 1,
  "block_headers": false,
  "datasource": {"type": "csv", "path": "../data/sample/tablecalc_v2.csv"},
  "calcs": [
    {"name": "Size", "formula": "SIZE()", "compute_using": ["Month"]},
    {"name": "Unique Rank", "formula": "RANK_UNIQUE(SUM([Sales]))", "compute_using": ["Month"]},
    {"name": "Unique Rank Asc", "formula": "RANK_UNIQUE(SUM([Sales]), 'asc')", "compute_using": ["Month"]},
    {"name": "Running Refunds", "formula": "RUNNING_SUM(SUM([Refunds]))", "compute_using": ["Month"]},
    {"name": "Running Avg", "formula": "RUNNING_AVG(SUM([Refunds]))", "compute_using": ["Month"]},
    {"name": "Running Min", "formula": "RUNNING_MIN(SUM([Refunds]))", "compute_using": ["Month"]},
    {"name": "Running Max", "formula": "RUNNING_MAX(SUM([Refunds]))", "compute_using": ["Month"]},
    {"name": "Running Count", "formula": "RUNNING_COUNT(SUM([Refunds]))", "compute_using": ["Month"]},
    {"name": "Window Count", "formula": "WINDOW_COUNT(SUM([Refunds]), -1, 1)", "compute_using": ["Month"]},
    {"name": "Window Sum Refunds", "formula": "WINDOW_SUM(SUM([Refunds]), -1, 0)", "compute_using": ["Month"]},
    {"name": "Window Median", "formula": "WINDOW_MEDIAN(SUM([Sales]), -2, 0)", "compute_using": ["Month"]},
    {"name": "Previous Value", "formula": "PREVIOUS_VALUE(0) + SUM([Sales])", "compute_using": ["Month"]}
  ],
  "sheets": [
    {"name": "Size", "type": "table", "rows": "Month", "cols": "Region", "measure": {"field": "Size"}},
    {"name": "Unique Rank", "type": "table", "rows": "Month", "cols": "Region", "measure": {"field": "Unique Rank"}},
    {"name": "Unique Rank Asc", "type": "table", "rows": "Month", "cols": "Region",
     "measure": {"field": "Unique Rank Asc"}},
    {"name": "Running Refunds", "type": "table", "rows": "Month", "cols": "Region",
     "measure": {"field": "Running Refunds"}},
    {"name": "Running Avg", "type": "table", "rows": "Month", "cols": "Region", "measure": {"field": "Running Avg"}},
    {"name": "Running Min", "type": "table", "rows": "Month", "cols": "Region", "measure": {"field": "Running Min"}},
    {"name": "Running Max", "type": "table", "rows": "Month", "cols": "Region", "measure": {"field": "Running Max"}},
    {"name": "Running Count", "type": "table", "rows": "Month", "cols": "Region",
     "measure": {"field": "Running Count"}},
    {"name": "Window Count", "type": "table", "rows": "Month", "cols": "Region",
     "measure": {"field": "Window Count"}},
    {"name": "Window Sum Refunds", "type": "table", "rows": "Month", "cols": "Region",
     "measure": {"field": "Window Sum Refunds"}},
    {"name": "Window Median", "type": "table", "rows": "Month", "cols": "Region",
     "measure": {"field": "Window Median"}},
    {"name": "Previous Value", "type": "table", "rows": "Month", "cols": "Region",
     "measure": {"field": "Previous Value"}}
  ],
  "dashboard": {"theme": "flat", "name": "Table Calc v2", "width": 1400, "height": 900,
                "grid": [["Size", "Unique Rank", "Unique Rank Asc", "Previous Value"],
                         ["Running Refunds", "Running Avg", "Running Min", "Running Max"],
                         ["Running Count", "Window Count", "Window Sum Refunds", "Window Median"]]}
}
