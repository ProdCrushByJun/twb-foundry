{
  "$schema": "../tbuilder/spec.schema.json",
  "version": 1,
  "datasource": {"type": "csv", "path": "../data/sample/sales_plan.csv"},
  "sheets": [
    {"name": "Target", "type": "bar", "title": "Sales **vs target** by manager", "subtitle": "{bad:Below target} against the plan line",
     "dimension": "Manager", "measure": {"field": "Sales"}, "sort": "desc",
     "reference": {"type": "target", "measure": {"field": "Plan"}}, "color": {"below": "target"}},
    {"name": "Totals", "type": "bar", "title": "Sales **by region**", "subtitle": "Managers stacked, the total at the bar end",
     "dimension": "Region", "measure": {"field": "Sales"}, "sort": "desc", "color": "Manager", "total": "end"},
    {"name": "Values", "type": "bar", "title": "Sales **by manager**", "subtitle": "The value beside the name",
     "dimension": "Manager", "measure": {"field": "Sales"}, "sort": "desc", "value_column": "left"}
  ],
  "dashboard": {"name": "Bar variants", "title": "**Bar** variants", "subtitle": "Sample data, 2025",
                "width": 1200, "height": 700, "grid": [["Target", "Totals", "Values"]]}
}
