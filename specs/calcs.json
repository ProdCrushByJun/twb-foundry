{
  "$schema": "../tbuilder/spec.schema.json",
  "version": 1,
  "block_headers": false,
  "datasource": {"type": "csv", "path": "../data/sample/sales.csv"},
  "calcs": [
    {"name": "Profit Ratio", "formula": "SUM([Profit]) / SUM([Sales])", "format": "percent"},
    {"name": "Tech Sales", "formula": "IF [Category] = \"Tech\" THEN [Sales] END"},
    {"name": "Order Size", "formula": "IF [Sales] >= 500 THEN \"Large\" ELSEIF [Sales] >= 300 THEN \"Medium\" ELSE \"Small\" END"}
  ],
  "sheets": [
    {"name": "KPI", "type": "kpi", "style": "tiles", "measures": [
      {"field": "Sales"}, {"field": "Profit Ratio"}, {"field": "Tech Sales"}]},
    {"name": "Ratio by Region", "type": "bar", "dimension": "Region", "measure": {"field": "Profit Ratio"}, "sort": "desc"},
    {"name": "Sales by Size", "type": "bar", "dimension": "Order Size", "measure": {"field": "Sales"}, "color": "Category"},
    {"name": "Ratio Matrix", "type": "heatmap", "rows": "Order Size", "cols": "Region", "measure": {"field": "Profit Ratio"}}
  ],
  "dashboard": {"theme": "flat", "name": "Calcs", "width": 1200, "height": 800, "row_heights": [1, 3],
                "grid": [["KPI"], ["Ratio by Region", "Sales by Size", "Ratio Matrix"]]}
}
