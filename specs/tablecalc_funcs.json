{
  "$schema": "../tbuilder/spec.schema.json",
  "version": 1,
  "block_headers": false,
  "datasource": {"type": "csv", "path": "../data/sample/sales.csv"},
  "calcs": [
    {"name": "Sales Rank", "formula": "RANK(SUM([Sales]))", "compute_using": ["Region"]},
    {"name": "Orders Rank", "formula": "RANK(COUNT([Sales]))", "compute_using": ["Region"]},
    {"name": "Orders Dense Rank", "formula": "RANK_DENSE(COUNT([Sales]), 'asc')", "compute_using": ["Region"]},
    {"name": "Sales vs Avg", "formula": "SUM([Sales]) - WINDOW_AVG(SUM([Sales]))", "compute_using": ["Region"]},
    {"name": "Moving Avg 3M", "formula": "WINDOW_AVG(SUM([Sales]), -2, 0)", "compute_using": ["Order Date"]},
    {"name": "Prev Month Sales", "formula": "LOOKUP(SUM([Sales]), -1)", "compute_using": ["Order Date"]},
    {"name": "Running Sales", "formula": "RUNNING_SUM(SUM([Sales]))", "compute_using": ["Order Date"]},
    {"name": "Cumulative Avg", "formula": "WINDOW_AVG(SUM([Sales]), FIRST(), 0)", "compute_using": ["Order Date"]},
    {"name": "Remaining Sales", "formula": "WINDOW_SUM(SUM([Sales]), 0, LAST())", "compute_using": ["Order Date"]},
    {"name": "Share in Category", "formula": "SUM([Sales]) / TOTAL(SUM([Sales]))", "compute_using": ["Region"],
     "format": "percent"},
    {"name": "Min-Max in Region",
     "formula": "(SUM([Sales]) - WINDOW_MIN(SUM([Sales]))) / (WINDOW_MAX(SUM([Sales])) - WINDOW_MIN(SUM([Sales])))",
     "compute_using": ["Category"], "format": "percent"},
    {"name": "Cell Index", "formula": "INDEX()", "compute_using": ["Region", "Category"]}
  ],
  "sheets": [
    {"name": "Sales Rank", "type": "bar", "dimension": "Region", "measure": {"field": "Sales Rank"}},
    {"name": "Orders Rank", "type": "bar", "dimension": "Region", "measure": {"field": "Orders Rank"}},
    {"name": "Orders Dense Rank", "type": "bar", "dimension": "Region", "measure": {"field": "Orders Dense Rank"}},
    {"name": "Sales vs Avg", "type": "bar", "dimension": "Region", "measure": {"field": "Sales vs Avg"}},
    {"name": "Moving Avg", "type": "line", "date": {"field": "Order Date", "level": "month"},
     "measure": {"field": "Moving Avg 3M"}},
    {"name": "Prev Month", "type": "line", "date": {"field": "Order Date", "level": "month"},
     "measure": {"field": "Prev Month Sales"}},
    {"name": "Running", "type": "line", "date": {"field": "Order Date", "level": "month"},
     "measure": {"field": "Running Sales"}},
    {"name": "Cumulative", "type": "line", "date": {"field": "Order Date", "level": "month"},
     "measure": {"field": "Cumulative Avg"}},
    {"name": "Remaining", "type": "line", "date": {"field": "Order Date", "level": "month"},
     "measure": {"field": "Remaining Sales"}},
    {"name": "Share", "type": "heatmap", "rows": "Region", "cols": "Category",
     "measure": {"field": "Share in Category"}},
    {"name": "Min-Max", "type": "table", "rows": "Region", "cols": "Category",
     "measure": {"field": "Min-Max in Region"}},
    {"name": "Index", "type": "table", "rows": "Region", "cols": "Category", "measure": {"field": "Cell Index"}}
  ],
  "dashboard": {"theme": "flat", "name": "Table Calc Functions", "width": 1400, "height": 1000,
                "grid": [["Sales Rank", "Orders Rank", "Orders Dense Rank"],
                         ["Sales vs Avg", "Moving Avg", "Prev Month"],
                         ["Running", "Cumulative", "Remaining"],
                         ["Share", "Min-Max", "Index"]]}
}
