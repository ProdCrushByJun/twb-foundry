{
  "$schema": "../tbuilder/spec.schema.json",
  "version": 1,
  "datasource": {"type": "csv", "path": "../data/sample/sales_plan.csv"},
  "sheets": [
    {"name": "Managers", "type": "bar", "title": "Sales **vs plan** by manager",
     "subtitle": "{bad:Below plan}; the line is the plan, gray zones under 80 % and 95 % of it",
     "dimension": "Manager", "measure": {"field": "Sales"}, "sort": "desc",
     "reference": {"type": "target", "measure": {"field": "Plan"}, "bands": [80, 95]}, "color": {"below": "target"}},
    {"name": "Regions", "type": "bar", "title": "Sales **vs plan** by region",
     "subtitle": "The line is the plan, gray zones under 50 %, 75 % and 90 % of it",
     "dimension": "Region", "measure": {"field": "Sales"}, "sort": "desc", "value_column": "left",
     "reference": {"type": "target", "measure": {"field": "Plan"}, "bands": [50, 75, 90]}}
  ],
  "dashboard": {"name": "Bullet", "title": "**Bullet** graphs", "subtitle": "Sample data, 2025",
                "width": 1200, "height": 700, "grid": [["Managers", "Regions"]]}
}
